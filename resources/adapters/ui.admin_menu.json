{
  "schema": "larena.ui.smart_adapter",
  "schema_version": 1,
  "id": "ui.admin_menu",
  "component_key": "ui.admin_menu",
  "source_contract": {"id": "smart.admin-menu", "version": "1.0.0"},
  "owner_package": "larena/ui",
  "accepted_props": {
    "source": "resources/smart/ui-admin-menu/manifest.json",
    "package_owned": ["current", "expected-columns"],
    "host_owned": ["aria-label", "search-shortcut", "open"],
    "user_draft_only": []
  },
  "allowed_events": {
    "sf-admin-menu-compact-change": "update host shell layout"
  },
  "transport": {
    "bridge": "larena.ui.admin_smart_event_bridge.v1",
    "port": "simai.admin-navigation-port 1.1.0, answered by larena/admin at /admin/navigation/menu",
    "csrf": "host supplied",
    "concurrency": "base_revision compare-and-set",
    "errors": ["validation", "forbidden", "revision_conflict", "transport"],
    "component_http_allowed": false
  },
  "ownership": {
    "data": "larena/admin navigation registry and resolver",
    "permissions": "larena/access",
    "persistence": "larena/setting through larena/admin",
    "rendering": "larena/ui Smart renderer",
    "interaction": "simai/ui-smart sf-admin-menu"
  },
  "forbidden": ["direct SF tags in Admin views", "client-owned access decisions", "route-specific JavaScript", "localStorage as Larena source of truth"],
  "examples": {
    "php": "Smart::render('ui.admin_menu', ['aria-label' => 'Admin navigation', 'expected-columns' => 2, 'id' => 'larena-product-menu'], $assetActivation);",
    "catalog": "/admin/ui/components/ui.admin_menu",
    "neutral_catalog": "https://ui-admin.test/smart-component-catalog.html"
  }
}
