      {"path": "src/smart/admin-menu/index.js", "sha256": "9cf0f29c0248dc0545703bdc6f7ed2308d6b5dad59c3d83ccf9de38b167a9eb4"},
      {"path": "src/smart/admin-menu/js/templates/default.js", "sha256": "5ebc15e091849255aad4a46041eb4cc1041aa7534635eef5f84d4bd8ac0e6dee"},
      {"path": "src/component/admin-menu/scss/_css__admin_menu.scss", "sha256": "db24e46372abab2a7a67650f7c4aa24e362000277862c168ee8c746b5b9a1291"}
    ],
